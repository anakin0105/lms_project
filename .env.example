# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,your-server-ip,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://your-domain.com,http://your-server-ip

# Database (PostgreSQL)
NAME=LMS
USER=postgres
PASSWORD=your-strong-password
